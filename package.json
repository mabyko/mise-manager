{
	"name": "mise-manager",
	"version": "0.1.0",
	"type": "module",
	"description": "Desktop app for mise plugin version management",
	"scripts": {
		"ui:build": "vite build",
		"ui:dev": "vite --port 5173",
		"start": "bun run ui:build && electrobun dev",
		"dev": "bun run ui:build && electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run ui:dev\" \"bun run dev\"",
		"build:canary": "bun run ui:build && electrobun build --env=canary",
		"build:stable": "bun run ui:build && electrobun build --env=stable",
		"build:stable:safe": "bash ./scripts/build-stable-safe.sh",
		"build:stable:force": "ALLOW_STABLE_BUILD=1 bash ./scripts/build-stable-safe.sh"
	},
	"dependencies": {
		"electrobun": "1.15.1"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"concurrently": "^9.2.1",
		"typescript": "^5.9.3",
		"vite": "^6.4.1"
	}
}
